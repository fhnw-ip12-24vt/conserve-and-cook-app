[Unit]
Description=ConserveAndCook Java GUI Application
After=graphical.target

[Service]
Type=simple
User=pi
Group=pi

# static DISPLAY & XAUTHORITY:
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority

# grab the Pi's session bus – adjust the UID if needed:
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

WorkingDirectory=/home/pi/deploy/Trick17App
ExecStart=/usr/bin/java \
  -Dsun.java2d.opengl=True \
  -XX:+UseZGC \
  -Xmx1G \
  -jar /home/pi/deploy/Trick17App/Trick17App.jar

Restart=on-failure

[Install]
WantedBy=graphical.target